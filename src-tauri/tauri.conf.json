{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MT Client",
  "version": "0.1.0",
  "identifier": "com.mtclient.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MT Client",
        "width": 1100,
        "height": 700,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
